# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=coursera_db

# Logging
LOG_LEVEL=debug

# Security
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT Authentication
# IMPORTANT: Change these secrets in production!
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=access-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=refresh-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_EXPIRY=7d
